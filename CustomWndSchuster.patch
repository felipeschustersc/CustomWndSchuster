@@ -0,0 +1,599 @@
+// Tamanho e titulo da janela HTML de NPC (NCNPCHtmlViewer) definidos pelo proprio HTML da pagina.
+// Tamanho: leitura de <html width height noscroll>, ApplyWindowSize e os hooks que o mantem
+// (LoadHtml, NCNPCHtmlViewer::OnPaint, NCScrollWnd::ShowScrollBar).
+// Titulo: leitura de <title color align>, ApplyTitleColor e o desvio da chamada que desenha o
+// texto do titulo (NCFrameCtrl, NWindow.dll+0x1BC40).
+
+#include "html_resize.h"
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+#include "MinHook.h"
+
+// ---- enderecos no NWindow.dll (RVA) ----
+#define RVA_LOADHTML            0x88440   // NCHtmlViewer::LoadHtml(const wchar_t*)
+#define RVA_NPCVIEWER_ONPAINT   0x837D0   // NCNPCHtmlViewer::OnPaint(canvas)
+#define RVA_SHOWSCROLLBAR       0x43C10   // NCScrollWnd::ShowScrollBar(int)
+#define RVA_SCROLLWND_SETSIZE   0x439B0   // NCScrollWnd::SetSize(float, float)
+#define RVA_DRAWTEXTURE         0x21A00   // canvas DrawTexture
+#define RVA_PUSHORIGIN          0x2F40    // canvas PushOrigin
+#define RVA_SETCLIPRECT         0x21DF0   // canvas SetClipRect
+#define RVA_POPORIGIN           0x212E0   // canvas PopOrigin
+#define RVA_NPCVIEWER_VTBL      0x24EF7C  // vtable do NCNPCHtmlViewer
+#define RVA_TITLE_DRAWCALL      0x1BC40   // NCFrameCtrl: "call DrawTextWithColor" do texto do titulo (E8 5B 5B 00 00)
+#define RVA_DRAWTEXTWITHCOLOR   0x217A0   // canvas DrawTextWithColor
+#define RVA_GETTEXTSIZE         0x20BB0   // medida de texto (largura, altura)
+
+#define TITLE_DEFAULT_COLOR     0xFFC8D2DC
+
+typedef void (__thiscall* fnDrawTexture)(void* canvas, int x, int y, int w, int h, int u, int v, int uw, int vh, void* tex, int alpha, int mask);
+typedef void (__thiscall* fnScrollWndSetSize)(void* scrollWnd, float width, float height);
+typedef void (__thiscall* fnPushOrigin)(void* canvas, int x, int y);
+typedef void (__thiscall* fnSetClipRect)(void* canvas, int x, int y, int w, int h);
+typedef void (__thiscall* fnPopOrigin)(void* canvas);
+typedef void (__thiscall* fnShowScrollBar)(void* window, int bShow);
+typedef void (__cdecl* fnGetTextSize)(int* outSize, const wchar_t* text, int p3, int p4, int p5, int p6, int p7, int p8);
+
+typedef struct HtmlPageMeta {
+    int customWidth;
+    int customHeight;
+    int noScroll;
+    int hasTitleColor;
+    unsigned int titleColor;
+    int titleAlign;             // 0 = padrao (centralizado se customWidth > 0), 1 = esquerda, 2 = centro, 3 = direita
+} HtmlPageMeta;
+
+typedef struct ControlEntry {
+    int flag;
+    void* control;
+    void* parent;
+    void* meta;
+} ControlEntry;
+
+static uintptr_t g_nwindowBase = 0;
+static fnDrawTexture g_pfnDrawTexture = NULL;
+static fnScrollWndSetSize g_pfnScrollWndSetSize = NULL;
+static fnPushOrigin g_pfnPushOrigin = NULL;
+static fnSetClipRect g_pfnSetClipRect = NULL;
+static fnPopOrigin g_pfnPopOrigin = NULL;
+static fnShowScrollBar g_pfnShowScrollBar = NULL;
+static fnGetTextSize g_pfnGetTextSize = NULL;
+void* g_pfnDrawTextWithColor __asm__("html_resize_drawtext") = NULL;
+
+static int (__thiscall* Original_LoadHtml)(void* thisPtr, const wchar_t* html) = NULL;
+static void (__thiscall* Original_NCNPCHtmlViewer_OnPaint)(void* thisPtr, void* canvas) = NULL;
+static void (__thiscall* Original_ShowScrollBar)(void* thisPtr, int bShow) = NULL;
+
+static HtmlPageMeta s_currentPage;
+static int s_bWasCustomSized = 0;
+static int s_bWasTitleColored = 0;
+static void* g_pColoredFrameCtrl = NULL;
+static unsigned int g_customTitleColor = TITLE_DEFAULT_COLOR;
+
+static int IsValidPointer(void* ptr) {
+    if (!ptr) return 0;
+    uintptr_t val = (uintptr_t)ptr;
+    if (val < 0x10000 || val >= 0x7FFF0000) return 0;
+    return 1;
+}
+
+// ---- leitura do <html ...> ----
+
+static int ExtractAttrValue(const wchar_t* tagStart, const wchar_t* tagEnd, const wchar_t* attrName, wchar_t* outVal, int maxLen) {
+    if (!tagStart || !tagEnd || !attrName || !outVal || maxLen <= 0) return 0;
+    outVal[0] = L'\0';
+
+    const wchar_t* p = tagStart;
+    size_t attrLen = wcslen(attrName);
+
+    while (p < tagEnd) {
+        if (_wcsnicmp(p, attrName, attrLen) == 0) {
+            wchar_t prevChar = (p == tagStart) ? L' ' : *(p - 1);
+            wchar_t nextChar = *(p + attrLen);
+            if ((prevChar == L' ' || prevChar == L'\t' || prevChar == L'<' || prevChar == L'\n' || prevChar == L'\r') &&
+                (nextChar == L'=' || nextChar == L' ' || nextChar == L'\t' || nextChar == L'>')) {
+
+                const wchar_t* eq = p + attrLen;
+                while (eq < tagEnd && (*eq == L' ' || *eq == L'\t')) eq++;
+
+                if (eq < tagEnd && *eq == L'=') {
+                    eq++;
+                    while (eq < tagEnd && (*eq == L' ' || *eq == L'\t')) eq++;
+
+                    int outIdx = 0;
+                    if (eq < tagEnd && (*eq == L'"' || *eq == L'\'')) {
+                        wchar_t quote = *eq++;
+                        while (eq < tagEnd && *eq != quote && outIdx < maxLen - 1) {
+                            outVal[outIdx++] = *eq++;
+                        }
+                    } else {
+                        while (eq < tagEnd && *eq != L' ' && *eq != L'\t' && *eq != L'>' && *eq != L'\r' && *eq != L'\n' && outIdx < maxLen - 1) {
+                            outVal[outIdx++] = *eq++;
+                        }
+                    }
+                    outVal[outIdx] = L'\0';
+                    return 1;
+                } else {
+                    // atributo booleano (ex.: noscroll)
+                    outVal[0] = L'1';
+                    outVal[1] = L'\0';
+                    return 1;
+                }
+            }
+        }
+        p++;
+    }
+    return 0;
+}
+
+static unsigned int ParseColorString(const wchar_t* str) {
+    if (!str || !str[0]) return TITLE_DEFAULT_COLOR;
+
+    while (*str == L' ' || *str == L'\t') str++;
+    if (*str == L'#') str++;
+    else if (_wcsnicmp(str, L"0x", 2) == 0) str += 2;
+
+    if (_wcsicmp(str, L"LEVEL") == 0) return 0xFFFFCC00;   // dourado do LEVEL do Interlude
+    if (_wcsicmp(str, L"WHITE") == 0) return 0xFFFFFFFF;
+    if (_wcsicmp(str, L"YELLOW") == 0 || _wcsicmp(str, L"GOLD") == 0) return 0xFFFFFF00;
+    if (_wcsicmp(str, L"RED") == 0) return 0xFFFF0000;
+    if (_wcsicmp(str, L"GREEN") == 0) return 0xFF00FF00;
+    if (_wcsicmp(str, L"BLUE") == 0) return 0xFF0000FF;
+    if (_wcsicmp(str, L"ORANGE") == 0) return 0xFFFF8000;
+    if (_wcsicmp(str, L"CYAN") == 0) return 0xFF00FFFF;
+    if (_wcsicmp(str, L"GRAY") == 0 || _wcsicmp(str, L"GREY") == 0) return 0xFF808080;
+
+    // hexadecimal RRGGBB -> 0xFFRRGGBB
+    unsigned int val = 0;
+    swscanf(str, L"%x", &val);
+    return 0xFF000000 | (val & 0x00FFFFFF);
+}
+
+static void ParseHtmlPage(const wchar_t* html) {
+    memset(&s_currentPage, 0, sizeof(s_currentPage));
+    if (!html) return;
+
+    const wchar_t* p = html;
+    wchar_t tempBuf[64];
+
+    while (*p) {
+        if (*p == L'<') {
+            const wchar_t* tagStart = p + 1;
+            while (*tagStart == L' ' || *tagStart == L'\t') tagStart++;
+
+            const wchar_t* tagEnd = wcschr(tagStart, L'>');
+            if (!tagEnd) break;
+
+            if (_wcsnicmp(tagStart, L"html", 4) == 0 && (tagStart[4] == L' ' || tagStart[4] == L'\t' || tagStart[4] == L'>')) {
+                if (ExtractAttrValue(tagStart, tagEnd, L"width", tempBuf, 64)) {
+                    s_currentPage.customWidth = _wtoi(tempBuf);
+                }
+                if (ExtractAttrValue(tagStart, tagEnd, L"height", tempBuf, 64)) {
+                    s_currentPage.customHeight = _wtoi(tempBuf);
+                }
+                if (ExtractAttrValue(tagStart, tagEnd, L"noscroll", tempBuf, 64) ||
+                    ExtractAttrValue(tagStart, tagEnd, L"noscrollbar", tempBuf, 64)) {
+                    s_currentPage.noScroll = 1;
+                }
+            }
+            else if (_wcsnicmp(tagStart, L"title", 5) == 0 && (tagStart[5] == L' ' || tagStart[5] == L'\t' || tagStart[5] == L'>')) {
+                if (ExtractAttrValue(tagStart, tagEnd, L"color", tempBuf, 64)) {
+                    s_currentPage.hasTitleColor = 1;
+                    s_currentPage.titleColor = ParseColorString(tempBuf);
+                }
+                if (ExtractAttrValue(tagStart, tagEnd, L"align", tempBuf, 64)) {
+                    if (_wcsicmp(tempBuf, L"left") == 0) s_currentPage.titleAlign = 1;
+                    else if (_wcsicmp(tempBuf, L"center") == 0) s_currentPage.titleAlign = 2;
+                    else if (_wcsicmp(tempBuf, L"right") == 0) s_currentPage.titleAlign = 3;
+                }
+            }
+            p = tagEnd + 1;
+        } else {
+            p++;
+        }
+    }
+}
+
+// ---- redimensionamento ----
+
+static void FindNpcControls(void* htmlViewer, void** outNpcViewer) {
+    *outNpcViewer = NULL;
+    if (!htmlViewer) return;
+
+    ControlEntry* entries = *(ControlEntry**)((char*)htmlViewer + 0xB8);
+    if (!IsValidPointer(entries)) return;
+
+    for (int i = 0; i < 16; i++) {
+        if (entries[i].flag != 1) break;
+        void* ctrl = entries[i].control;
+        if (!IsValidPointer(ctrl)) break;
+
+        void** vtbl = *(void***)ctrl;
+        if (!IsValidPointer(vtbl)) continue;
+
+        if ((uintptr_t)vtbl - g_nwindowBase == RVA_NPCVIEWER_VTBL) {
+            *outNpcViewer = ctrl;
+            break;
+        }
+    }
+}
+
+typedef void (__thiscall* fnSetFrameSize)(void*, float, float);
+
+static void PlaceCloseButton(void* npchtmlViewer, void* titleCtrl, float targetW, int show) {
+    // botao fechar (FrameCloseBtn) em [titleCtrl + 0x2F8] ou [titleCtrl + 0x2FC]
+    void* closeBtn = *(void**)((char*)titleCtrl + 0x2F8);
+    if (!closeBtn || !IsValidPointer(closeBtn)) {
+        closeBtn = *(void**)((char*)titleCtrl + 0x2FC);
+    }
+    if (closeBtn && IsValidPointer(closeBtn)) {
+        int originX = *(int*)((char*)npchtmlViewer + 0x80);
+        int originY = *(int*)((char*)npchtmlViewer + 0x84);
+        *(int*)((char*)closeBtn + 0x80) = originX + (int)targetW - 22;
+        *(int*)((char*)closeBtn + 0x84) = originY + 4;
+        *(float*)((char*)closeBtn + 0x88) = 15.0f;
+        *(float*)((char*)closeBtn + 0x8C) = 15.0f;
+        if (show) *(int*)((char*)closeBtn + 0xAC) |= 2;
+    }
+}
+
+static void HideControl(void* ctrl) {
+    if (ctrl && IsValidPointer(ctrl)) {
+        *(int*)((char*)ctrl + 0x80) = -2000;
+        *(int*)((char*)ctrl + 0x84) = -2000;
+        *(int*)((char*)ctrl + 0xAC) &= ~2;
+    }
+}
+
+static void PlaceScrollButton(void* btn, int x, int y) {
+    if (btn && IsValidPointer(btn)) {
+        *(int*)((char*)btn + 0x80) = x;
+        *(int*)((char*)btn + 0x84) = y;
+        *(float*)((char*)btn + 0x88) = 15.0f;
+        *(float*)((char*)btn + 0x8C) = 15.0f;
+        *(int*)((char*)btn + 0xAC) |= 2;
+    }
+}
+
+static void ApplyWindowSize(void* htmlViewer, int width, int height, int noScroll) {
+    if (!htmlViewer) return;
+
+    // pagina padrao e janela nunca redimensionada: nao mexe em nada
+    if (width <= 0 && height <= 0 && !s_bWasCustomSized) return;
+
+    void* npchtmlViewer = NULL;
+    FindNpcControls(htmlViewer, &npchtmlViewer);
+
+    if (width > 0 && height > 0) {
+        s_bWasCustomSized = 1;
+        float targetW = (float)width;
+        float targetH = (float)height;
+
+        // 1. janela NCNPCHtmlViewer + barra de titulo
+        if (npchtmlViewer && IsValidPointer(npchtmlViewer)) {
+            *(float*)((char*)npchtmlViewer + 0x88) = targetW;
+            *(float*)((char*)npchtmlViewer + 0x8C) = targetH;
+
+            void* titleCtrl = *(void**)((char*)npchtmlViewer + 0xC0);   // NCNameCtrl
+            if (titleCtrl && IsValidPointer(titleCtrl)) {
+                *(float*)((char*)titleCtrl + 0x88) = targetW;
+                *(float*)((char*)titleCtrl + 0x8C) = 20.0f;
+
+                // SetFrameSize nativo via vtable[0xA8] (RVA 0x59010)
+                void** vtbl = *(void***)npchtmlViewer;
+                if (IsValidPointer(vtbl) && IsValidPointer(vtbl[0xA8 / 4])) {
+                    ((fnSetFrameSize)vtbl[0xA8 / 4])(npchtmlViewer, targetW, 20.0f);
+                }
+                PlaceCloseButton(npchtmlViewer, titleCtrl, targetW, 1);
+            }
+        }
+
+        // 2. area de conteudo NCHtmlViewer: fica em (X+7, Y+30), logo W = largura - 14, H = altura - 37.
+        // Com noscroll, devolve os 16 px que o NWindow.dll desconta da barra de rolagem no layout.
+        float contentW = targetW - 14.0f + (noScroll ? 16.0f : 0.0f);
+        float contentH = targetH - 37.0f;
+        if (contentW > 0.0f && contentH > 0.0f) {
+            if (g_pfnScrollWndSetSize) {
+                g_pfnScrollWndSetSize(htmlViewer, contentW, contentH);
+            } else {
+                *(float*)((char*)htmlViewer + 0x88) = contentW;
+                *(float*)((char*)htmlViewer + 0x8C) = contentH;
+            }
+        }
+
+        // 3. barra de rolagem
+        if (noScroll) {
+            *(int*)((char*)htmlViewer + 0x1E8) = 0;   // bShowScrollBar
+            *(int*)((char*)htmlViewer + 0x1E0) = 0;   // largura da barra
+            *(int*)((char*)htmlViewer + 0x204) = 0;
+            if (g_pfnShowScrollBar) g_pfnShowScrollBar(htmlViewer, 0);
+            HideControl(*(void**)((char*)htmlViewer + 0x1EC));   // botao para cima
+            HideControl(*(void**)((char*)htmlViewer + 0x1F0));   // botao para baixo
+            HideControl(*(void**)((char*)htmlViewer + 0x1FC));   // slider
+        } else {
+            *(int*)((char*)htmlViewer + 0x1E8) = 1;
+            *(int*)((char*)htmlViewer + 0x1E0) = 15;
+            *(int*)((char*)htmlViewer + 0x204) = 15;
+            if (npchtmlViewer && IsValidPointer(npchtmlViewer)) {
+                int originX = *(int*)((char*)npchtmlViewer + 0x80);
+                int originY = *(int*)((char*)npchtmlViewer + 0x84);
+                int barX = originX + (int)targetW - 22;
+                PlaceScrollButton(*(void**)((char*)htmlViewer + 0x1EC), barX, originY + 30);
+                PlaceScrollButton(*(void**)((char*)htmlViewer + 0x1F0), barX, originY + (int)targetH - 22);
+            }
+        }
+    } else if (s_bWasCustomSized) {
+        // volta ao tamanho padrao do dialogo de NPC (310 x 401)
+        s_bWasCustomSized = 0;
+
+        if (npchtmlViewer && IsValidPointer(npchtmlViewer)) {
+            *(float*)((char*)npchtmlViewer + 0x88) = 310.0f;
+            *(float*)((char*)npchtmlViewer + 0x8C) = 401.0f;
+
+            void* titleCtrl = *(void**)((char*)npchtmlViewer + 0xC0);
+            if (titleCtrl && IsValidPointer(titleCtrl)) {
+                *(float*)((char*)titleCtrl + 0x88) = 310.0f;
+                *(float*)((char*)titleCtrl + 0x8C) = 20.0f;
+                *(unsigned int*)((char*)titleCtrl + 0x348) = 0xFFFFFFFF;
+
+                void** vtbl = *(void***)npchtmlViewer;
+                if (IsValidPointer(vtbl) && IsValidPointer(vtbl[0xA8 / 4])) {
+                    ((fnSetFrameSize)vtbl[0xA8 / 4])(npchtmlViewer, 310.0f, 20.0f);
+                }
+                PlaceCloseButton(npchtmlViewer, titleCtrl, 310.0f, 0);
+            }
+        }
+
+        if (g_pfnScrollWndSetSize) {
+            g_pfnScrollWndSetSize(htmlViewer, 296.0f, 364.0f);
+        } else {
+            *(float*)((char*)htmlViewer + 0x88) = 296.0f;
+            *(float*)((char*)htmlViewer + 0x8C) = 364.0f;
+        }
+        *(int*)((char*)htmlViewer + 0x1E8) = 1;
+        *(int*)((char*)htmlViewer + 0x1E0) = 15;
+        *(int*)((char*)htmlViewer + 0x204) = 15;
+    }
+}
+
+// ---- cor do titulo ----
+static void ApplyTitleColor(void* htmlViewer, int hasColor, unsigned int color) {
+    if (!htmlViewer) return;
+    if (!hasColor && !s_bWasTitleColored) return;
+
+    void* npchtmlViewer = NULL;
+    FindNpcControls(htmlViewer, &npchtmlViewer);
+    if (!npchtmlViewer || !IsValidPointer(npchtmlViewer)) {
+        if (!hasColor) {
+            g_pColoredFrameCtrl = NULL;
+            g_customTitleColor = TITLE_DEFAULT_COLOR;
+        }
+        return;
+    }
+
+    void* titleCtrl = *(void**)((char*)npchtmlViewer + 0xC0);
+    if (titleCtrl && IsValidPointer(titleCtrl)) {
+        if (hasColor) {
+            s_bWasTitleColored = 1;
+            g_pColoredFrameCtrl = titleCtrl;
+            g_customTitleColor = color;
+        } else if (s_bWasTitleColored) {
+            s_bWasTitleColored = 0;
+            g_pColoredFrameCtrl = NULL;
+            g_customTitleColor = TITLE_DEFAULT_COLOR;
+        }
+    }
+}
+
+// ---- texto do titulo: cor e alinhamento ----
+// Chamado pelo desvio no lugar do "call DrawTextWithColor" do NCFrameCtrl: troca a cor e a posicao X
+// antes do desenho original.
+void AdjustFrameTitle(void* frameCtrl, int* pX, unsigned int* pColor, const wchar_t* text) __asm__("html_resize_adjust_title");
+void AdjustFrameTitle(void* frameCtrl, int* pX, unsigned int* pColor, const wchar_t* text) {
+    if (!frameCtrl) return;
+
+    if (frameCtrl == g_pColoredFrameCtrl && pColor) {
+        *pColor = g_customTitleColor;
+    }
+
+    if (pX && text && text[0] && g_pfnGetTextSize) {
+        int shouldCenter = (s_currentPage.titleAlign == 2) || (s_currentPage.titleAlign == 0 && s_currentPage.customWidth > 0);
+        int shouldRight = (s_currentPage.titleAlign == 3);
+
+        if (shouldCenter || shouldRight) {
+            int winW = (int)*(float*)((char*)frameCtrl + 0x88);
+            if (winW > 0) {
+                int outSize[2] = {0, 0};
+                g_pfnGetTextSize(outSize, text, 0, 0, 0, 0, 0, 0);
+                int textW = outSize[0];
+                if (textW > 0 && textW < winW - 30) {
+                    *pX = shouldCenter ? (winW - textW) / 2 : winW - textW - 25;
+                    *(int*)((char*)frameCtrl + 0x320) = *pX;
+                }
+            }
+        }
+    }
+}
+
+// Desvio de "call DrawTextWithColor" (NWindow.dll+0x1BC40): esi = NCFrameCtrl; chama
+// AdjustFrameTitle(frameCtrl, &x, &cor, texto) e segue para o DrawTextWithColor original.
+__attribute__((naked, used)) static void Hook_DrawFrameTitleText(void) {
+    __asm__ volatile (
+        "pushl %ecx\n\t"
+        "pushl %edx\n\t"
+        "pushl 24(%esp)\n\t"
+        "leal 24(%esp), %eax\n\t"
+        "pushl %eax\n\t"
+        "leal 20(%esp), %eax\n\t"
+        "pushl %eax\n\t"
+        "pushl %esi\n\t"
+        "call html_resize_adjust_title\n\t"
+        "addl $16, %esp\n\t"
+        "popl %edx\n\t"
+        "popl %ecx\n\t"
+        "jmpl *html_resize_drawtext\n\t"
+    );
+}
+
+static const unsigned char kTitleCallBytes[5] = { 0xE8, 0x5B, 0x5B, 0x00, 0x00 };
+
+static int PatchTitleCall(uintptr_t base, int install) {
+    unsigned char* site = (unsigned char*)(base + RVA_TITLE_DRAWCALL);
+    unsigned char code[5];
+    if (install) {
+        if (memcmp(site, kTitleCallBytes, 5) != 0) return 0;     // NWindow.dll diferente: nao mexe
+        int rel = (int)((uintptr_t)Hook_DrawFrameTitleText - ((uintptr_t)site + 5));
+        code[0] = 0xE8;
+        memcpy(code + 1, &rel, 4);
+    } else {
+        memcpy(code, kTitleCallBytes, 5);
+    }
+    DWORD old;
+    if (!VirtualProtect(site, 5, PAGE_EXECUTE_READWRITE, &old)) return 0;
+    memcpy(site, code, 5);
+    VirtualProtect(site, 5, old, &old);
+    FlushInstructionCache(GetCurrentProcess(), site, 5);
+    return 1;
+}
+
+// ---- fundo esticado em 9 partes ----
+// Na textura NPCHtml_BACK a area visivel e 310 x 381; o fundo comeca em Y = 20 (abaixo do titulo).
+static void Draw9SliceBackground(void* canvas, void* tex, int winW, int winH) {
+    if (!canvas || !tex || !g_pfnDrawTexture) return;
+
+    int srcW = 310, srcH = 381;
+    int cL = 20, cR = 20, cT = 20, cB = 20;   // cantos
+
+    int destW = winW;
+    int destH = winH - 20;
+    int destCW = destW - cL - cR;
+    int destCH = destH - cT - cB;
+    int srcCW = srcW - cL - cR;
+    int srcCH = srcH - cT - cB;
+
+    if (destCW <= 0 || destCH <= 0) {
+        g_pfnDrawTexture(canvas, 0, 20, destW, destH, 0, 0, srcW, srcH, tex, 255, 1);
+        return;
+    }
+
+    g_pfnDrawTexture(canvas, 0, 20, cL, cT, 0, 0, cL, cT, tex, 255, 1);                                      // canto sup. esq.
+    g_pfnDrawTexture(canvas, cL, 20, destCW, cT, cL, 0, srcCW, cT, tex, 255, 1);                             // borda superior
+    g_pfnDrawTexture(canvas, winW - cR, 20, cR, cT, srcW - cR, 0, cR, cT, tex, 255, 1);                      // canto sup. dir.
+    g_pfnDrawTexture(canvas, 0, 20 + cT, cL, destCH, 0, cT, cL, srcCH, tex, 255, 1);                         // borda esquerda
+    g_pfnDrawTexture(canvas, cL, 20 + cT, destCW, destCH, cL, cT, srcCW, srcCH, tex, 255, 1);                // centro
+    g_pfnDrawTexture(canvas, winW - cR, 20 + cT, cR, destCH, srcW - cR, cT, cR, srcCH, tex, 255, 1);         // borda direita
+    g_pfnDrawTexture(canvas, 0, winH - cB, cL, cB, 0, srcH - cB, cL, cB, tex, 255, 1);                       // canto inf. esq.
+    g_pfnDrawTexture(canvas, cL, winH - cB, destCW, cB, cL, srcH - cB, srcCW, cB, tex, 255, 1);              // borda inferior
+    g_pfnDrawTexture(canvas, winW - cR, winH - cB, cR, cB, srcW - cR, srcH - cB, cR, cB, tex, 255, 1);       // canto inf. dir.
+}
+
+// ---- hooks ----
+
+// NCHtmlViewer::LoadHtml: le tamanho e titulo e aplica antes e depois (o UpdateScrollBar interno desfaria)
+static int __fastcall Hooked_LoadHtml(void* thisPtr, void* edx, const wchar_t* html) {
+    (void)edx;
+    ParseHtmlPage(html);
+    ApplyWindowSize(thisPtr, s_currentPage.customWidth, s_currentPage.customHeight, s_currentPage.noScroll);
+    ApplyTitleColor(thisPtr, s_currentPage.hasTitleColor, s_currentPage.titleColor);
+    int res = Original_LoadHtml(thisPtr, html);
+    ApplyWindowSize(thisPtr, s_currentPage.customWidth, s_currentPage.customHeight, s_currentPage.noScroll);
+    ApplyTitleColor(thisPtr, s_currentPage.hasTitleColor, s_currentPage.titleColor);
+    return res;
+}
+
+// NCNPCHtmlViewer::OnPaint: com tamanho personalizado, desenha o fundo esticado e mantem titulo,
+// botao fechar e barra de rolagem acompanhando a janela (ela pode ser arrastada)
+static void __fastcall Hooked_NCNPCHtmlViewer_OnPaint(void* thisPtr, void* edx, void* canvas) {
+    (void)edx;
+    if (!thisPtr || !canvas) return;
+
+    if (s_currentPage.customWidth <= 0 || s_currentPage.customHeight <= 0) {
+        Original_NCNPCHtmlViewer_OnPaint(thisPtr, canvas);
+        return;
+    }
+
+    int winX = *(int*)((char*)thisPtr + 0x80);
+    int winY = *(int*)((char*)thisPtr + 0x84);
+    int winW = (int)*(float*)((char*)thisPtr + 0x88);
+    int winH = (int)*(float*)((char*)thisPtr + 0x8C);
+
+    void* titleCtrl = *(void**)((char*)thisPtr + 0xC0);
+    if (titleCtrl && IsValidPointer(titleCtrl)) {
+        *(float*)((char*)titleCtrl + 0x88) = (float)winW;
+        *(float*)((char*)titleCtrl + 0x8C) = 20.0f;
+        PlaceCloseButton(thisPtr, titleCtrl, (float)winW, 1);
+    }
+
+    void* htmlViewer = *(void**)((char*)thisPtr + 0x1CC);
+    if (htmlViewer && IsValidPointer(htmlViewer)) {
+        void* btnUp = *(void**)((char*)htmlViewer + 0x1EC);
+        void* btnDown = *(void**)((char*)htmlViewer + 0x1F0);
+        void* slider = *(void**)((char*)htmlViewer + 0x1FC);
+        if (s_currentPage.noScroll) {
+            HideControl(btnUp);
+            HideControl(btnDown);
+            HideControl(slider);
+        } else {
+            int barX = winX + winW - 22;
+            PlaceScrollButton(btnUp, barX, winY + 30);
+            PlaceScrollButton(btnDown, barX, winY + winH - 22);
+        }
+    }
+
+    if (g_pfnPushOrigin) g_pfnPushOrigin(canvas, winX, winY);
+    if (g_pfnSetClipRect) g_pfnSetClipRect(canvas, winX, winY, winW, winH);
+
+    void* defaultTex = *(void**)((char*)thisPtr + 0x1D0);   // NPCHtml_BACK
+    if (defaultTex) Draw9SliceBackground(canvas, defaultTex, winW, winH);
+
+    *(int*)((char*)canvas + 0x38) = 0;
+    *(int*)((char*)canvas + 0x3C) = 0;
+    if (g_pfnPopOrigin) g_pfnPopOrigin(canvas);
+}
+
+// NCScrollWnd::ShowScrollBar: com noscroll a barra nunca volta
+static void __fastcall Hooked_ShowScrollBar(void* thisPtr, void* edx, int bShow) {
+    (void)edx;
+    Original_ShowScrollBar(thisPtr, s_currentPage.noScroll ? 0 : bShow);
+}
+
+// ---- instalacao ----
+
+int HtmlResize_Init(uintptr_t base) {
+    if (!base) return 0;
+    g_nwindowBase = base;
+
+    g_pfnDrawTexture = (fnDrawTexture)(base + RVA_DRAWTEXTURE);
+    g_pfnScrollWndSetSize = (fnScrollWndSetSize)(base + RVA_SCROLLWND_SETSIZE);
+    g_pfnPushOrigin = (fnPushOrigin)(base + RVA_PUSHORIGIN);
+    g_pfnSetClipRect = (fnSetClipRect)(base + RVA_SETCLIPRECT);
+    g_pfnPopOrigin = (fnPopOrigin)(base + RVA_POPORIGIN);
+    g_pfnShowScrollBar = (fnShowScrollBar)(base + RVA_SHOWSCROLLBAR);
+    g_pfnGetTextSize = (fnGetTextSize)(base + RVA_GETTEXTSIZE);
+    g_pfnDrawTextWithColor = (void*)(base + RVA_DRAWTEXTWITHCOLOR);
+
+    PatchTitleCall(base, 1);          // cor/alinhamento do titulo (ignorado se o NWindow.dll for outro)
+
+    MH_STATUS s = MH_Initialize();
+    if (s != MH_OK && s != MH_ERROR_ALREADY_INITIALIZED) return 0;
+
+    if (MH_CreateHook((void*)(base + RVA_LOADHTML), (void*)&Hooked_LoadHtml, (void**)&Original_LoadHtml) != MH_OK) return 0;
+    if (MH_CreateHook((void*)(base + RVA_NPCVIEWER_ONPAINT), (void*)&Hooked_NCNPCHtmlViewer_OnPaint, (void**)&Original_NCNPCHtmlViewer_OnPaint) != MH_OK) return 0;
+    if (MH_CreateHook((void*)(base + RVA_SHOWSCROLLBAR), (void*)&Hooked_ShowScrollBar, (void**)&Original_ShowScrollBar) != MH_OK) return 0;
+
+    // depois de criado o hook, o ShowScrollBar chamado pelo ApplyWindowSize passa pelo original
+    g_pfnShowScrollBar = Original_ShowScrollBar;
+
+    return MH_EnableHook(MH_ALL_HOOKS) == MH_OK;
+}
+
+void HtmlResize_Shutdown(void) {
+    if (!g_nwindowBase) return;
+    if (memcmp((void*)(g_nwindowBase + RVA_TITLE_DRAWCALL), kTitleCallBytes, 5) != 0)
+        PatchTitleCall(g_nwindowBase, 0);
+    MH_DisableHook((void*)(g_nwindowBase + RVA_LOADHTML));
+    MH_DisableHook((void*)(g_nwindowBase + RVA_NPCVIEWER_ONPAINT));
+    MH_DisableHook((void*)(g_nwindowBase + RVA_SHOWSCROLLBAR));
+    MH_Uninitialize();
+    g_nwindowBase = 0;
+}
diff --git a/src/main.c b/src/main.c
new file mode 100644
index 0000000..26fe4fa
--- /dev/null
+++ b/src/main.c
@@ -0,0 +1,30 @@
+// CustomWndSchuster.dll - DLL independente com o tamanho e o titulo da janela HTML de NPC.
+// Espera o NWindow.dll ser carregado pelo cliente e instala os hooks.
+// Para embutir em outra DLL, nao use este arquivo: inclua html_resize.c/.h e chame
+// HtmlResize_Init(base do NWindow.dll) depois que o NWindow.dll estiver carregado.
+
+#include "html_resize.h"
+
+static DWORD WINAPI InitThread(LPVOID param) {
+    (void)param;
+    HMODULE hNWnd = NULL;
+    for (int i = 0; i < 1200 && !hNWnd; i++) {      // ate 120 s
+        hNWnd = GetModuleHandleA("NWindow.dll");
+        if (!hNWnd) Sleep(100);
+    }
+    if (!hNWnd) return 0;
+    Sleep(300);                                      // deixa o NWindow.dll terminar a propria inicializacao
+    HtmlResize_Init((uintptr_t)hNWnd);
+    return 0;
+}
+
+BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpReserved) {
+    (void)lpReserved;
+    if (fdwReason == DLL_PROCESS_ATTACH) {
+        DisableThreadLibraryCalls(hinstDLL);
+        CreateThread(NULL, 0, InitThread, NULL, 0, NULL);
+    } else if (fdwReason == DLL_PROCESS_DETACH) {
+        HtmlResize_Shutdown();
+    }
+    return TRUE;
+}
diff --git a/proxy/dsetup.c b/proxy/dsetup.c
new file mode 100644
index 0000000..b84ff0b
--- /dev/null
+++ b/proxy/dsetup.c
@@ -0,0 +1,64 @@
+// dsetup.dll proxy: faz o cliente carregar a CustomWndSchuster.dll sem alterar o L2.exe.
+//
+// Por que a dsetup.dll?
+//   O L2.exe do Interlude importa uma unica funcao da dsetup.dll (DirectX Setup da Microsoft):
+//   DirectXSetupGetVersion, pelo ordinal 11. Como o Windows procura a DLL primeiro na pasta do
+//   executavel (system), basta colocar ali uma dsetup.dll "falsa" que exporte essa funcao para
+//   que ela seja carregada junto com o jogo, antes da janela abrir.
+//
+// O que este proxy faz (DLL_PROCESS_ATTACH):
+//   1. descobre a pasta em que ele mesmo esta (a pasta system do cliente);
+//   2. carrega a dsetup.dll original, renomeada para dsetup_base.dll, e guarda o endereco da
+//      DirectXSetupGetVersion dela (ordinal 11);
+//   3. carrega a CustomWndSchuster.dll da mesma pasta. Ela cria uma thread propria que espera o
+//      NWindow.dll e instala os hooks; por isso nada mais precisa ser feito aqui.
+//
+// DirectXSetupGetVersion:
+//   repassa a chamada para a dsetup_base.dll. Se ela nao existir, responde DirectX 9.0c
+//   (4.09.00.0904), o que basta para o cliente abrir normalmente.
+//
+// Exportacao: dsetup.def exporta a funcao com o nome "DirectXSetupGetVersion" e o ordinal 11,
+// igual a original (o L2.exe importa pelo ordinal).
+//
+// Para carregar outras DLLs alem da CustomWndSchuster.dll, repita o bloco do passo 3 com o nome
+// de cada uma.
+
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef int (__stdcall *fnGetVersion)(DWORD*, DWORD*);
+static HMODULE g_hBase = NULL;                   // dsetup_base.dll (a original da Microsoft)
+static fnGetVersion g_pfnGetVersion = NULL;      // DirectXSetupGetVersion original
+
+BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpReserved) {
+    (void)lpReserved;
+    if (fdwReason == DLL_PROCESS_ATTACH) {
+        DisableThreadLibraryCalls(hinstDLL);
+
+        // 1. pasta deste proxy, com a barra final (ex.: "C:\Lineage II\system\")
+        char dir[MAX_PATH] = {0};
+        GetModuleFileNameA(hinstDLL, dir, MAX_PATH);
+        char* lastSlash = strrchr(dir, '\\');
+        if (lastSlash) *(lastSlash + 1) = '\0';
+
+        // 2. dsetup.dll original, renomeada para dsetup_base.dll
+        char path[MAX_PATH];
+        snprintf(path, sizeof(path), "%sdsetup_base.dll", dir);
+        g_hBase = LoadLibraryA(path);
+        if (g_hBase) g_pfnGetVersion = (fnGetVersion)GetProcAddress(g_hBase, (LPCSTR)11);
+
+        // 3. CustomWndSchuster.dll (se nao existir, o cliente abre normalmente, sem a funcionalidade)
+        snprintf(path, sizeof(path), "%sCustomWndSchuster.dll", dir);
+        LoadLibraryA(path);
+    }
+    return TRUE;
+}
+
+// Unica funcao que o L2.exe usa da dsetup.dll (ordinal 11).
+__declspec(dllexport) int __stdcall DirectXSetupGetVersion(DWORD* pdwVersion, DWORD* pdwMinorVersion) {
+    if (g_pfnGetVersion) return g_pfnGetVersion(pdwVersion, pdwMinorVersion);
+    if (pdwVersion) *pdwVersion = 0x00040009;       // DirectX 9.0c
+    if (pdwMinorVersion) *pdwMinorVersion = 904;
+    return 1;
+}
diff --git a/proxy/dsetup.def b/proxy/dsetup.def
new file mode 100644
index 0000000..1a48929
--- /dev/null
+++ b/proxy/dsetup.def
@@ -0,0 +1,5 @@
+; Exporta a DirectXSetupGetVersion com o mesmo ordinal (11) da dsetup.dll original da Microsoft,
+; que e o que o L2.exe importa. "@8" e a decoracao __stdcall (2 parametros de 4 bytes).
+LIBRARY dsetup
+EXPORTS
+    DirectXSetupGetVersion = DirectXSetupGetVersion@8 @11
diff --git a/build.bat b/build.bat
new file mode 100644
index 0000000..3613055
--- /dev/null
+++ b/build.bat
@@ -0,0 +1,39 @@
+@echo off
+rem Compila a CustomWndSchuster.dll (tamanho e titulo da janela HTML de NPC) e o proxy
+rem proxy\out\dsetup.dll, que faz o cliente carregar a DLL. Veja o README.md.
+rem
+rem Requer o zig (https://ziglang.org/download/). O script usa, nesta ordem:
+rem   1. a variavel de ambiente ZIG (ex.: set ZIG=C:\zig\zig.exe), se existir;
+rem   2. o zig.exe que estiver no PATH.
+rem Uso: build.bat [--no-pause]
+
+setlocal
+cd /d "%~dp0"
+
+if defined ZIG (
+    set "ZIGEXE=%ZIG:"=%"
+) else (
+    for /f "delims=" %%i in ('where zig 2^>nul') do if not defined ZIGEXE set "ZIGEXE=%%i"
+)
+if not defined ZIGEXE (
+    echo [ERRO] zig nao encontrado. Instale o zig ou defina a variavel ZIG com o caminho do zig.exe.
+    goto :fail
+)
+
+echo [1/2] Compilando CustomWndSchuster.dll...
+"%ZIGEXE%" cc -target x86-windows-gnu -O2 -shared "-Wl,--image-base=0x24000000" -Iminhook -Iminhook\include ^
+    -o CustomWndSchuster.dll src\main.c src\html_resize.c minhook\buffer.c minhook\hook.c minhook\trampoline.c minhook\HDE\hde32.c || goto :fail
+
+echo [2/2] Compilando proxy dsetup.dll...
+if not exist proxy\out mkdir proxy\out
+"%ZIGEXE%" cc -target x86-windows-gnu -O2 -shared "-Wl,--image-base=0x20000000" proxy\dsetup.def -o proxy\out\dsetup.dll proxy\dsetup.c || goto :fail
+
+del /q *.lib *.pdb proxy\out\*.lib proxy\out\*.pdb 2>nul
+echo [OK] CustomWndSchuster.dll e proxy\out\dsetup.dll gerados.
+if not "%1"=="--no-pause" pause
+exit /b 0
+
+:fail
+echo [ERRO] Build falhou.
+if not "%1"=="--no-pause" pause
+exit /b 1
diff --git a/README.md b/README.md
new file mode 100644
index 0000000..2b2440c
--- /dev/null
+++ b/README.md
@@ -0,0 +1,494 @@
+# CustomWndSchuster
+
+DLL para o cliente **Lineage II Interlude** que permite ao servidor definir, pelo próprio HTML,
+o **tamanho** da janela de diálogo de NPC e a **cor** e o **alinhamento** do título dela.
+
+```html
+<html width=500 height=420 noscroll>
+  <title color=LEVEL align=center>Minha janela</title>
+  ...
+</html>
+```
+
+- **Não precisa alterar o servidor.** Qualquer servidor (aCis, L2J, etc.) só envia o HTML; os
+  atributos novos são lidos pelo cliente.
+- **Não precisa alterar o `L2.exe` nem o `NWindow.dll`.** A DLL é carregada por um proxy da
+  `dsetup.dll` (incluído aqui) e aplica tudo na memória.
+- Páginas que não usam os atributos continuam exatamente como no cliente original.
+
+---
+
+## Índice
+
+1. [Conteúdo do repositório](#1-conteúdo-do-repositório)
+2. [Compatibilidade](#2-compatibilidade)
+3. [Instalação no cliente](#3-instalação-no-cliente)
+4. [Uso no HTML](#4-uso-no-html)
+5. [Servidor](#5-servidor)
+6. [Compilando](#6-compilando)
+7. [O proxy dsetup.dll](#7-o-proxy-dsetupdll)
+8. [Como a CustomWndSchuster.dll funciona](#8-como-a-customwndschusterdll-funciona)
+9. [Usando o código em outra DLL](#9-usando-o-código-em-outra-dll)
+10. [Solução de problemas](#10-solução-de-problemas)
+11. [Desinstalação](#11-desinstalação)
+12. [Licenças](#12-licenças)
+
+---
+
+## 1. Conteúdo do repositório
+
+```
+CustomWndSchuster/
+├── src/
+│   ├── html_resize.h        API pública: HtmlResize_Init / HtmlResize_Shutdown
+│   ├── html_resize.c        toda a funcionalidade (leitura do HTML, tamanho, título, hooks)
+│   └── main.c               DllMain da CustomWndSchuster.dll (espera o NWindow.dll e instala)
+├── proxy/
+│   ├── dsetup.c             proxy da dsetup.dll que carrega a CustomWndSchuster.dll
+│   ├── dsetup.def           exportação da DirectXSetupGetVersion no ordinal 11
+│   └── out/dsetup.dll       proxy já compilado
+├── minhook/                 MinHook (biblioteca de hooks, licença BSD 2-Clause em minhook/LICENSE.txt)
+├── build.bat                compila as duas DLLs com zig (x86)
+├── LICENSE                  licença MIT deste projeto
+├── CustomWndSchuster.dll    DLL já compilada
+└── CustomWndSchuster.patch  src/, proxy/, build.bat e este README em formato diff
+```
+
+As DLLs já compiladas (`CustomWndSchuster.dll` e `proxy/out/dsetup.dll`) podem ser usadas
+direto, sem compilar nada.
+
+---
+
+## 2. Compatibilidade
+
+A DLL acessa funções internas do `NWindow.dll` (a biblioteca de interface do cliente) por
+endereço fixo. Por isso, ela só funciona com o **`NWindow.dll` do Interlude** para o qual esses
+endereços foram levantados.
+
+**`NWindow.dll` de referência** (testado):
+
+| | |
+|---|---|
+| Tamanho | 3.850.260 bytes |
+| SHA-256 | `cb85f7a5de375f1e9156ec6559aae2a0a809b3abac4150142aafb14bbf02b47b` |
+
+Um `NWindow.dll` com hash diferente ainda pode ser compatível, desde que o código nos endereços
+abaixo seja o mesmo. Por exemplo, há clientes com poucos bytes alterados em outras partes. Neste
+arquivo, o offset no disco é igual ao RVA, então dá para conferir com qualquer editor
+hexadecimal:
+
+| Offset / RVA | Bytes esperados | Função |
+|---|---|---|
+| `0x1BC40` | `E8 5B 5B 00 00` | chamada que desenha o texto do título |
+| `0x88440` | `55 8D AC 24 70 FF FF FF` | `NCHtmlViewer::LoadHtml` |
+| `0x837D0` | `55 8B EC 6A FF 68 F0 A5` | `NCNPCHtmlViewer::OnPaint` |
+| `0x43C10` | `55 8B EC 6A FF 68 A0 EB` | `NCScrollWnd::ShowScrollBar` |
+
+> **Atenção:** se esses bytes não baterem, **não use** a DLL nesse cliente. Os hooks seriam
+> instalados em endereços errados e o cliente provavelmente fecharia com erro. Os endereços
+> precisariam ser levantados de novo para esse `NWindow.dll` (veja a [seção 8](#8-como-a-customwndschusterdll-funciona)).
+> Só o desvio do título confere os bytes antes de ser aplicado (os outros hooks não conferem).
+
+Outros requisitos:
+- cliente de 32 bits (todo cliente Interlude é);
+- a pasta `system` do cliente precisa ter a `dsetup.dll`. O `L2.exe` do Interlude importa essa
+  DLL.
+
+---
+
+## 3. Instalação no cliente
+
+Todos os arquivos vão na pasta **`system`** do cliente (a mesma do `L2.exe` e do `NWindow.dll`).
+
+### 3.1 Cliente com a `dsetup.dll` original (caso mais comum)
+
+A `dsetup.dll` original é a da Microsoft (DirectX Setup). Ela tem cerca de 62 KB, e nas
+propriedades do arquivo (aba Detalhes) aparece "Microsoft Corporation".
+
+1. **Renomeie** a `dsetup.dll` original para **`dsetup_base.dll`**. Não apague: o proxy repassa
+   a chamada para ela.
+2. **Copie** `proxy/out/dsetup.dll` para a pasta `system`.
+3. **Copie** `CustomWndSchuster.dll` para a pasta `system`.
+
+Resultado:
+
+```
+system/
+├── L2.exe
+├── NWindow.dll
+├── dsetup.dll              ← proxy (deste repositório)
+├── dsetup_base.dll         ← dsetup.dll original da Microsoft, renomeada
+└── CustomWndSchuster.dll   ← esta DLL
+```
+
+Abra o jogo normalmente pelo `L2.exe`.
+
+### 3.2 Cliente que já tem uma `dsetup.dll` modificada
+
+Alguns clientes já trocaram a `dsetup.dll` original por uma própria, para carregar proteção ou
+outras DLLs. Nesse caso, escolha uma das opções:
+
+- **Opção A (recomendada): carregar pela DLL que você já usa.** Se você tem o código dela, adicione
+  `LoadLibraryA("CustomWndSchuster.dll");` (com o caminho da pasta `system`) no `DLL_PROCESS_ATTACH`.
+  Não use o proxy deste repositório.
+- **Opção B: encadear.** Renomeie a `dsetup.dll` atual para `dsetup_base.dll` e instale o proxy
+  como no item 3.1. Isso só funciona se a DLL atual exportar o ordinal 11
+  (`DirectXSetupGetVersion`) e **não** carregar ela mesma um arquivo chamado `dsetup_base.dll`.
+  Se carregar, ela carregaria a si própria, e a chamada ficaria em recursão infinita.
+
+### 3.3 Conferindo se carregou
+
+Com o jogo aberto, abra qualquer NPC cujo HTML use `<html width=... height=...>`. A janela
+deve abrir no tamanho informado. Para conferir só o carregamento, ferramentas como o
+*Process Explorer* (Sysinternals) mostram as DLLs carregadas no processo `L2.exe`; procure
+`CustomWndSchuster.dll`.
+
+---
+
+## 4. Uso no HTML
+
+Os atributos são escritos nas tags `<html>` e `<title>` da página enviada pelo servidor.
+
+### 4.1 Atributos
+
+| Tag | Atributo | Valores | Efeito |
+|---|---|---|---|
+| `<html>` | `width` | número (px) | largura total da janela. Padrão do cliente: **310** |
+| `<html>` | `height` | número (px) | altura total da janela, incluindo a barra de título. Padrão do cliente: **401** |
+| `<html>` | `noscroll` | sem valor | esconde a barra de rolagem e devolve os 16 px dela para o conteúdo. `noscrollbar` também funciona |
+| `<title>` | `color` | `#RRGGBB`, `0xRRGGBB`, `RRGGBB` ou um nome (abaixo) | cor do texto do título |
+| `<title>` | `align` | `left`, `center`, `right` | posição do texto do título |
+
+Regras:
+- `width` e `height` só têm efeito **juntos**. Com apenas um dos dois, a janela fica no tamanho
+  padrão.
+- Use `noscroll` junto com `width` e `height`. Numa janela de tamanho padrão, ele esconde a
+  barra, mas o conteúdo não ganha a largura dela.
+- `color` e `align` funcionam também em janelas de tamanho padrão.
+- Sem `align`, o título fica **centralizado** quando a janela tem tamanho personalizado; caso
+  contrário, fica na posição original do cliente.
+- Nomes de tag e atributo não diferenciam maiúsculas e minúsculas. Valores podem ser escritos
+  com ou sem aspas (`width=500`, `width="500"` e `width='500'` são equivalentes).
+- Cada página é lida do zero. Quando o jogador abre uma página **sem** os atributos, a janela,
+  a barra de rolagem e o título voltam ao padrão sozinhos.
+
+Nomes de cor aceitos em `color`:
+
+| Nome | Cor |
+|---|---|
+| `LEVEL` | `#FFCC00` (o mesmo dourado do `<font color="LEVEL">`) |
+| `WHITE` | `#FFFFFF` |
+| `YELLOW` ou `GOLD` | `#FFFF00` |
+| `RED` | `#FF0000` |
+| `GREEN` | `#00FF00` |
+| `BLUE` | `#0000FF` |
+| `ORANGE` | `#FF8000` |
+| `CYAN` | `#00FFFF` |
+| `GRAY` ou `GREY` | `#808080` |
+
+Sem `color`, o título usa a cor original do cliente.
+
+### 4.2 Medidas para montar o layout
+
+A janela tem uma barra de título de 20 px, e o conteúdo começa 7 px à esquerda e 30 px abaixo do
+topo. A área disponível para o HTML fica assim:
+
+| | Com barra de rolagem | Com `noscroll` |
+|---|---|---|
+| Largura útil para o HTML | `width - 30` | `width - 14` |
+| Altura visível | `height - 37` | `height - 37` |
+
+Exemplo: `<html width=500 height=420 noscroll>` deixa 486 x 383 px para o conteúdo. Uma
+`<table width=480>` cabe sem cortar. Na janela padrão (310 x 401, com barra), a largura útil é de
+280 px.
+
+O fundo padrão da janela (`NPCHtml_BACK`) é esticado em 9 partes: os cantos de 20 px mantêm o
+tamanho, e as bordas e o centro esticam. Por isso, a moldura não deforma em nenhum tamanho. O
+título, o botão de fechar e a barra de rolagem acompanham a janela, inclusive quando ela é
+arrastada.
+
+### 4.3 Exemplos
+
+Janela larga, sem rolagem, título dourado centralizado:
+
+```html
+<html width=600 height=300 noscroll>
+<title color=LEVEL align=center>Loja de Eventos</title>
+<body>
+  <table width=580>
+    <tr><td align=center>Bem-vindo!</td></tr>
+  </table>
+</body>
+</html>
+```
+
+Tamanho padrão, só com o título colorido à esquerda:
+
+```html
+<html>
+<title color="#00FFFF" align=left>Teleporte</title>
+<body>...</body>
+</html>
+```
+
+Janela alta com rolagem (listas longas):
+
+```html
+<html width=350 height=600>
+<title>Ranking</title>
+<body>...</body>
+</html>
+```
+
+---
+
+## 5. Servidor
+
+Não é preciso alterar o código do servidor. O servidor só envia o texto do HTML, e quem
+interpreta os atributos é o cliente. Basta editar os arquivos `.htm` (ou o HTML gerado pelo
+código).
+
+Em clientes sem a DLL, os atributos são simplesmente ignorados e a janela abre no tamanho padrão.
+Por isso, dá para usar os atributos mesmo que nem todos os jogadores tenham a DLL.
+
+Dois cuidados:
+- **Cache de HTML:** depois de editar um `.htm`, recarregue o cache do servidor (por exemplo,
+  `//reload htm`, conforme o servidor) ou reinicie-o.
+- **Limite de tamanho:** alguns servidores limitam o tamanho de uma página HTML. Os
+  atributos acrescentam poucos caracteres, mas janelas grandes tendem a ter páginas grandes.
+  Confira o limite do seu servidor (por exemplo, a constante de tamanho máximo em
+  `NpcHtmlMessage`).
+
+---
+
+## 6. Compilando
+
+Só é preciso compilar se você alterar o código. As DLLs compiladas já acompanham o repositório.
+
+### 6.1 Requisitos
+
+- [zig](https://ziglang.org/download/) (testado com a 0.16). Ele traz o compilador C e as
+  bibliotecas do Windows; não precisa de Visual Studio.
+- Windows (o `build.bat` é um script do `cmd`).
+
+### 6.2 Compilar
+
+```bat
+build.bat
+```
+
+O script procura o zig na variável de ambiente `ZIG` (por exemplo,
+`set ZIG=C:\zig\zig.exe`) e, se ela não existir, no `PATH`. Ele gera:
+
+- `CustomWndSchuster.dll`;
+- `proxy\out\dsetup.dll`.
+
+Use `build.bat --no-pause` para não esperar uma tecla no final (útil em scripts).
+
+Comandos equivalentes, para rodar à mão:
+
+```bat
+zig cc -target x86-windows-gnu -O2 -shared "-Wl,--image-base=0x24000000" -Iminhook -Iminhook\include ^
+    -o CustomWndSchuster.dll src\main.c src\html_resize.c ^
+    minhook\buffer.c minhook\hook.c minhook\trampoline.c minhook\HDE\hde32.c
+
+zig cc -target x86-windows-gnu -O2 -shared "-Wl,--image-base=0x20000000" ^
+    proxy\dsetup.def -o proxy\out\dsetup.dll proxy\dsetup.c
+```
+
+- `-target x86-windows-gnu`: obrigatório, porque o cliente é de 32 bits.
+- `--image-base`: endereço preferido de carga de cada DLL, escolhido para não disputar espaço
+  com as DLLs do cliente. Se o Windows precisar, ele realoca a DLL normalmente.
+- Um aviso sobre maiúsculas/minúsculas em um `#include` do MinHook pode aparecer. É inofensivo.
+
+### 6.3 Outros compiladores
+
+O código é C comum e também compila com MinGW (i686) ou com clang, usando as mesmas opções. O
+desvio do título usa assembly no estilo GCC/clang (`__attribute__((naked))` e `__asm__`), então
+o MSVC não compila o `html_resize.c` sem adaptar essa função.
+
+---
+
+## 7. O proxy dsetup.dll
+
+Arquivos: [proxy/dsetup.c](proxy/dsetup.c) e [proxy/dsetup.def](proxy/dsetup.def).
+
+### 7.1 Por que a dsetup.dll
+
+O `L2.exe` do Interlude importa uma única função da `dsetup.dll` (DirectX Setup, da Microsoft):
+`DirectXSetupGetVersion`, pelo **ordinal 11**. Ao abrir um programa, o Windows procura as DLLs
+primeiro na pasta do executável. Assim, uma `dsetup.dll` colocada na pasta `system` é carregada
+junto com o jogo, antes de a janela abrir, e pode carregar outras DLLs. Isso dispensa injetores
+e alterações no `L2.exe`.
+
+### 7.2 O que ele faz
+
+Ao ser carregado (`DLL_PROCESS_ATTACH`):
+
+1. descobre a pasta em que está, que é a `system` (`GetModuleFileNameA`);
+2. carrega `dsetup_base.dll` dessa pasta (a original renomeada) e guarda o endereço da
+   `DirectXSetupGetVersion` dela (ordinal 11);
+3. carrega `CustomWndSchuster.dll` dessa pasta.
+
+A função exportada `DirectXSetupGetVersion(DWORD* versao, DWORD* revisao)` repassa a chamada
+para a original. Se a `dsetup_base.dll` não existir, ela mesma responde DirectX 9.0c
+(`0x00040009`, revisão `904`), e isso basta para o cliente abrir. Se a `CustomWndSchuster.dll`
+não existir, o cliente abre normalmente, só sem a funcionalidade.
+
+O arquivo `dsetup.def` exporta a função com o mesmo nome e o mesmo ordinal (11) da original:
+
+```
+LIBRARY dsetup
+EXPORTS
+    DirectXSetupGetVersion = DirectXSetupGetVersion@8 @11
+```
+
+`@8` é a decoração do `__stdcall`: dois parâmetros de 4 bytes.
+
+### 7.3 Carregar outras DLLs pelo mesmo proxy
+
+Para carregar mais DLLs, repita o passo 3 do `DllMain` com o nome de cada uma e recompile:
+
+```c
+snprintf(path, sizeof(path), "%sOutraDll.dll", dir);
+LoadLibraryA(path);
+```
+
+---
+
+## 8. Como a CustomWndSchuster.dll funciona
+
+### 8.1 Inicialização
+
+[src/main.c](src/main.c): no `DLL_PROCESS_ATTACH`, a DLL cria uma thread que espera o
+`NWindow.dll` ser carregado. Ela verifica a cada 100 ms, por até 120 s. Depois, espera mais
+300 ms para o `NWindow.dll` terminar a própria inicialização e chama
+`HtmlResize_Init(base do NWindow.dll)`. No `DLL_PROCESS_DETACH`, chama `HtmlResize_Shutdown()`,
+que desfaz os hooks.
+
+`HtmlResize_Init` ([src/html_resize.c](src/html_resize.c)):
+
+1. calcula o endereço das funções internas usadas (base + RVA);
+2. troca a chamada que desenha o texto do título por um desvio, depois de conferir os bytes
+   originais (`E8 5B 5B 00 00`);
+3. instala três hooks com o MinHook: `LoadHtml`, `OnPaint` da janela de NPC e `ShowScrollBar`.
+
+### 8.2 Fluxo ao abrir uma página
+
+1. **`NCHtmlViewer::LoadHtml`** (hook): antes de o cliente montar a página, `ParseHtmlPage` lê
+   `width`, `height`, `noscroll`, `color` e `align`.
+   - `ApplyWindowSize` redimensiona a janela de NPC (`NCNPCHtmlViewer`), a barra de título, o
+     botão de fechar, a área de conteúdo e a barra de rolagem.
+   - `ApplyTitleColor` registra a cor do título.
+   - As duas funções rodam de novo **depois** do `LoadHtml` original, que recalcula a barra de
+     rolagem e desfaria o ajuste.
+   - Uma página sem os atributos restaura o padrão: 310 x 401, conteúdo de 296 x 364 e barra
+     visível.
+2. **`NCNPCHtmlViewer::OnPaint`** (hook), só com tamanho personalizado: mantém o título, o
+   botão de fechar e a barra de rolagem na posição certa (a janela pode ter sido arrastada) e
+   desenha o fundo `NPCHtml_BACK` esticado em 9 partes (`Draw9SliceBackground`). Com o tamanho
+   padrão, o desenho original é usado.
+3. **Texto do título** (desvio em `NWindow.dll+0x1BC40`): o `NCFrameCtrl` desenha o título com
+   `DrawTextWithColor`. A instrução `call` foi trocada por `Hook_DrawFrameTitleText`, que chama
+   `AdjustFrameTitle(frame, &x, &cor, texto)`. Essa função troca a cor (só no título da janela de
+   NPC), mede o texto e calcula o `x` para centralizar ou alinhar à direita. Depois, segue para o
+   `DrawTextWithColor` original.
+4. **`NCScrollWnd::ShowScrollBar`** (hook): com `noscroll`, sempre esconde a barra, porque o
+   cliente tenta mostrá-la de novo em vários momentos.
+
+### 8.3 Endereços usados (RVAs no `NWindow.dll`)
+
+Definidos no início de [src/html_resize.c](src/html_resize.c):
+
+| Constante | RVA | Função |
+|---|---|---|
+| `RVA_LOADHTML` | `0x88440` | `NCHtmlViewer::LoadHtml(const wchar_t*)` |
+| `RVA_NPCVIEWER_ONPAINT` | `0x837D0` | `NCNPCHtmlViewer::OnPaint(canvas)` |
+| `RVA_SHOWSCROLLBAR` | `0x43C10` | `NCScrollWnd::ShowScrollBar(int)` |
+| `RVA_SCROLLWND_SETSIZE` | `0x439B0` | `NCScrollWnd::SetSize(float, float)` |
+| `RVA_DRAWTEXTURE` | `0x21A00` | canvas `DrawTexture` |
+| `RVA_PUSHORIGIN` | `0x2F40` | canvas `PushOrigin` |
+| `RVA_SETCLIPRECT` | `0x21DF0` | canvas `SetClipRect` |
+| `RVA_POPORIGIN` | `0x212E0` | canvas `PopOrigin` |
+| `RVA_NPCVIEWER_VTBL` | `0x24EF7C` | vtable do `NCNPCHtmlViewer` (identifica a janela de NPC) |
+| `RVA_TITLE_DRAWCALL` | `0x1BC40` | `call DrawTextWithColor` do título no `NCFrameCtrl` |
+| `RVA_DRAWTEXTWITHCOLOR` | `0x217A0` | canvas `DrawTextWithColor` |
+| `RVA_GETTEXTSIZE` | `0x20BB0` | medida de texto (largura, altura) |
+
+O código também usa offsets de campos dos objetos do `NWindow.dll`, por exemplo `+0x80/+0x84`
+(posição X/Y), `+0x88/+0x8C` (largura/altura), `+0xC0` (barra de título) e `+0x1E0..+0x204`
+(barra de rolagem). Os comentários ao lado de cada uso explicam o campo. Para portar a DLL para
+outro `NWindow.dll`, é preciso levantar de novo os RVAs **e** esses offsets.
+
+---
+
+## 9. Usando o código em outra DLL
+
+Se você já tem uma DLL própria no cliente, não precisa de uma DLL separada:
+
+1. copie `src/html_resize.c` e `src/html_resize.h`, e também a pasta `minhook/` se o projeto
+   ainda não usa o MinHook;
+2. depois que o `NWindow.dll` estiver carregado, chame:
+
+   ```c
+   #include "html_resize.h"
+   HtmlResize_Init((uintptr_t)GetModuleHandleA("NWindow.dll"));   // retorna 1 se ok
+   ```
+
+3. ao descarregar, chame `HtmlResize_Shutdown();`.
+
+Se o seu projeto já inicializa o MinHook, não há problema: `HtmlResize_Init` aceita
+`MH_ERROR_ALREADY_INITIALIZED`. Mas `HtmlResize_Shutdown` chama `MH_Uninitialize()`, então, se
+outros hooks seus dependem do MinHook, chame-a só no final ou remova essa linha.
+
+Não carregue duas DLLs que enganchem as mesmas funções do `NWindow.dll`, como duas cópias deste
+código ou outra DLL com funcionalidade parecida: os hooks entrariam em conflito.
+
+Para usar o patch em formato diff: `git apply CustomWndSchuster.patch`, em uma pasta vazia,
+recria `src/`, `proxy/`, `build.bat`, o `LICENSE` e este README. O MinHook não vai no diff. Copie a pasta
+`minhook/` ou baixe-o em <https://github.com/TsudaKageyu/minhook>.
+
+---
+
+## 10. Solução de problemas
+
+| Sintoma | Causa provável | O que fazer |
+|---|---|---|
+| Cliente não abre e diz que falta uma DLL ou um ponto de entrada | o proxy foi copiado sem a original, ou o arquivo errado foi renomeado | confira a [seção 3.1](#31-cliente-com-a-dsetupdll-original-caso-mais-comum): `dsetup.dll` = proxy, `dsetup_base.dll` = original |
+| Cliente fecha ao abrir ou ao falar com um NPC | `NWindow.dll` diferente do suportado | confira os bytes da [seção 2](#2-compatibilidade). Se não baterem, remova a DLL |
+| A janela não muda de tamanho | faltou `width` ou `height`, a DLL não carregou, ou o servidor está com o HTML antigo em cache | use os dois atributos, confira o carregamento ([seção 3.3](#33-conferindo-se-carregou)) e recarregue o HTML no servidor |
+| A DLL não carrega | o antivírus bloqueou ou apagou a DLL (é comum com DLLs que fazem hooks), ou a pasta não é a `system` | adicione uma exceção no antivírus e confira se os arquivos estão ao lado do `L2.exe` |
+| O conteúdo fica cortado à direita | a tabela é mais larga que a área de conteúdo | use as medidas da [seção 4.2](#42-medidas-para-montar-o-layout) |
+| A cor do título não muda | valor de cor inválido | use `#RRGGBB` ou um dos nomes da tabela |
+| Com outra DLL de interface, algo some ou fica estranho | duas DLLs enganchando as mesmas funções | use só uma delas |
+
+---
+
+## 11. Desinstalação
+
+Na pasta `system`:
+
+1. apague `CustomWndSchuster.dll`;
+2. apague a `dsetup.dll` (o proxy);
+3. renomeie `dsetup_base.dll` de volta para `dsetup.dll`.
+
+Nada mais é alterado no cliente. Os arquivos do jogo e o `NWindow.dll` no disco nunca são
+modificados.
+
